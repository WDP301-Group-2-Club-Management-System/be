# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — NEVER commit real credentials.

PORT=9999
BASE_URL=localhost
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
MONGO_URI_LOCAL=mongodb://localhost:27017/club-management-system
USE_LOCAL=false

# Google OAuth (login with Google)
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# JWT — REQUIRED for login to work. Any random string is fine in dev.
JWT_SECRET=<any-random-secret-string>
JWT_EXPIRES_IN=1d

# Gmail SMTP (register-verification + forgot-password emails).
# Optional in dev: when missing, OTP codes are logged to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=<your-gmail-address>
SMTP_PASS=<gmail-app-password>
SMTP_FROM=<display-from-address>

# PayOS payment gateway (my.payos.vn) — needed only for membership-fee
# payment testing; endpoints respond 503 gracefully when missing.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
FRONTEND_URL=http://localhost:3000
